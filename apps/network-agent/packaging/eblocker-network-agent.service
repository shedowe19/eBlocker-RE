[Unit]
Description=eBlocker read-only network agent
Documentation=file:/usr/share/doc/eblocker-network-agent/README.md
After=network.target

[Service]
Type=simple
User=eblocker-network-agent
Group=eblocker-network-agent
RuntimeDirectory=eblocker
RuntimeDirectoryMode=0750
ExecStart=/usr/lib/eblocker-network-agent/eblocker-network-agent --socket /run/eblocker/network-agent.sock
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/eblocker
LimitNOFILE=256
TasksMax=64
MemoryMax=128M
Environment=GOMEMLIMIT=96MiB

[Install]
WantedBy=multi-user.target
